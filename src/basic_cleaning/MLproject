name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Input artifact for cleaning
        type: string

      output_artifact:
        description: Cleaned output artifact
        type: string

      output_type:
        description: Type of output artifact
        type: string

      output_description:
        description: Description of output artifact
        type: string

      min_price:
        description: Min price for outlier removal
        type: float

      max_price:
        description: Max price for outlier removal
        type: float


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
